<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.diashowstudio.app">

    <!-- Nur technisch für die WebView nötig. Die App lädt nichts aus dem Internet,
         alle Anfragen nach außen werden blockiert. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nur Android 7–9: Videos und Bilder in der Galerie speichern -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Bilder aus der Galerie direkt an Diashow Studio teilen -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Gibt fertige Videos/Bilder zum Teilen und Abspielen an andere Apps weiter -->
        <provider
            android:name=".ShareProvider"
            android:authorities="de.diashowstudio.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
