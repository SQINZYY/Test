<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.weckton.app">

    <!-- Wecker der Samsung-Uhr lesen und den Klingelton ändern (von der Uhr-App als "normal" freigegeben) -->
    <uses-permission android:name="com.sec.android.app.clockpackage.permission.READ_ALARM" />
    <uses-permission android:name="com.sec.android.app.clockpackage.permission.WRITE_ALARM" />
    <!-- Ohne diese Berechtigung öffnet die Samsung-Uhr ihre Wecker-Liste nicht für andere Apps -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Uhr-App im Hintergrund beenden, damit sie beim Öffnen den nächsten Wecker neu plant -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Optional: MP3 als Standard-Weckton des Handys setzen (fragt Android extra nach) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Ab Android 11 sieht eine App andere Apps nur, wenn sie sie hier nennt -->
    <queries>
        <package android:name="com.sec.android.app.clockpackage" />
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- MP3 aus dem Dateimanager o. Ä. direkt an Weckton teilen -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
